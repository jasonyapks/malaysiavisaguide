# Cache lifetimes for the static export.
#
# Next copies public/ verbatim into out/, and out/ is what gets uploaded, so
# this file arrives at the deploy root where Pages looks for it — the same route
# _redirects beside it already takes. Production was serving max-age=14400 on
# everything, content-hashed assets included, which throws away the one caching
# guarantee a hashed filename buys you.
#
# /_next/static/* is safe to pin for a year because the filenames carry a
# content hash: a changed file is a changed URL, so a cached copy can never go
# stale. `immutable` additionally stops revalidation on reload.
#
# /images/* gets 30 days rather than the same treatment, because those filenames
# are NOT content-hashed. scripts/pull-images.mjs writes each photo to a stable
# path — public/images/cms/<key>.webp — and replaces it in place when the
# picture behind a key changes. Marking those immutable for a year would strand
# a superseded photo in visitors' caches with no way to evict it.
#
# HTML is deliberately absent and therefore uncached. Every page here is a
# static file that gets rewritten on each deploy at the same URL, and the review
# dates and fee figures are the entire point of the site — a cached document is
# a wrong document.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

# The brand assets live at the root rather than under /images/, so the rule
# above misses them. Same 30 days for the same reason: stable paths, replaced
# in place. figures.json is deliberately absent; it is regenerated on every
# build from the programme data and a stale copy would state a wrong fee.
#
# logo-mark.webp is the one file preloaded on every page — it is the header
# mark, cropped from the master artwork at MVG_logo.png. logo-mark.png is the
# same crop at 256px for email, print and the CMS, and is not requested by any
# page. Same 30 days for the same reason: stable paths, replaced in place.
/logo-mark.webp
  Cache-Control: public, max-age=2592000

/logo-mark.png
  Cache-Control: public, max-age=2592000

/og.png
  Cache-Control: public, max-age=2592000

# The Sveltia CMS editor. Never indexed, on any host.
#
# The header is what a crawler obeys; /admin/index.html carries a robots meta
# tag as well, because the two cost nothing together and the failure mode — the
# editor turning up in a search result for "malaysiavisaguide admin" — is the
# kind you only notice months later.
#
# Both patterns are listed on purpose. A prefix rule matches what is UNDER the
# prefix, and the editor's own URL is the directory itself, so `/admin/*` alone
# would leave the one page that matters uncovered. That trap has already been
# paid for once here with the root brand assets.
/admin/
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

# The CMS bundle is 1.9 MB and its path is stable, so it is not content-hashed
# and cannot be immutable. A week is long enough to matter for a tool opened
# most days, and short enough that an upgrade lands without anyone clearing a
# cache.
/admin/sveltia-cms.js
  Cache-Control: public, max-age=604800
