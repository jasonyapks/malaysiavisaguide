# Security headers for every response.
#
# `/*` matches everything the project serves — pages, hashed assets, the brand
# files at the root and the CMS under /admin/ — and Pages applies every matching
# rule cumulatively, so these stack on top of the Cache-Control blocks below
# rather than replacing them. Verified on the wire: a hashed chunk still carries
# `immutable` from its own block while gaining these, which also proves the
# headers survive the functions/_middleware round trip.
#
# What each line buys, and why it is safe to ship enforcing:
#
#   Strict-Transport-Security  Pins HTTPS for a year, subdomains included, so a
#     downgrade/strip on cn. or tw. can't happen. `preload` is set because the
#     apex is eligible; submit it at hstspreload.org once this is live.
#   Content-Security-Policy    ONLY the three directives that cannot break a
#     resource load: frame-ancestors 'none' is the real clickjacking fix (the
#     CMS holds a repo-write token once Jason signs in, so a framed /admin/ is
#     the case that matters), base-uri locks <base>, object-src kills plugins.
#     The full script/style/img/connect policy is shipped Report-Only below so
#     it can be watched before it is enforced — a static export can't nonce its
#     inline scripts, so enforcing script-src needs hashes worked out first.
#   X-Frame-Options            Legacy twin of frame-ancestors for old browsers.
#   Referrer-Policy            Already the site default; stated here so it is
#     not one Pages release away from changing under us.
#   Permissions-Policy         Nothing here uses camera/mic/geolocation, so deny
#     them outright — a compromised script can't turn them on.
#   Cross-Origin-Opener-Policy Severs window.opener between this and any popup.
#   X-Content-Type-Options     Belt to the MIME sniffers.
#
# The Report-Only line is the full policy the site actually needs: gtag from
# googletagmanager, the contact form POSTing to web3forms, the news/insights
# reads to the mvg-news Worker, and GA's collect endpoints. It reports
# violations without blocking, so a missing origin surfaces as a console note
# and a report, not a broken page. Promote it to the enforcing header once the
# reports are clean and the inline scripts carry hashes.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://api.web3forms.com https://mvg-news.jason-6bf.workers.dev https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; form-action 'self' https://api.web3forms.com

# The CMS origin is the one place a wildcard CORS could ever matter — it is the
# only surface that will hold a credential (the GitHub token, in localStorage).
# Nothing legitimately reads /admin/ cross-origin, so pin the Pages default `*`
# down to the site itself. Both patterns are listed for the same reason the
# X-Robots block below lists both: `/admin/*` alone misses the editor's own URL.
/admin/
  Access-Control-Allow-Origin: https://malaysiavisaguide.com
/admin/*
  Access-Control-Allow-Origin: https://malaysiavisaguide.com

# Cache lifetimes for the static export.
#
# Next copies public/ verbatim into out/, and out/ is what gets uploaded, so
# this file arrives at the deploy root where Pages looks for it — the same route
# _redirects beside it already takes. Production was serving max-age=14400 on
# everything, content-hashed assets included, which throws away the one caching
# guarantee a hashed filename buys you.
#
# /_next/static/* is safe to pin for a year because the filenames carry a
# content hash: a changed file is a changed URL, so a cached copy can never go
# stale. `immutable` additionally stops revalidation on reload.
#
# /images/* gets 30 days rather than the same treatment, because those filenames
# are NOT content-hashed. scripts/pull-images.mjs writes each photo to a stable
# path — public/images/cms/<key>.webp — and replaces it in place when the
# picture behind a key changes. Marking those immutable for a year would strand
# a superseded photo in visitors' caches with no way to evict it.
#
# HTML is deliberately absent and therefore uncached. Every page here is a
# static file that gets rewritten on each deploy at the same URL, and the review
# dates and fee figures are the entire point of the site — a cached document is
# a wrong document.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

# The brand assets live at the root rather than under /images/, so the rule
# above misses them. Same 30 days for the same reason: stable paths, replaced
# in place. figures.json is deliberately absent; it is regenerated on every
# build from the programme data and a stale copy would state a wrong fee.
#
# logo-mark.webp is the one file preloaded on every page — it is the header
# mark, cropped from the master artwork at MVG_logo.png. logo-mark.png is the
# same crop at 256px for email, print and the CMS, and is not requested by any
# page. Same 30 days for the same reason: stable paths, replaced in place.
/logo-mark.webp
  Cache-Control: public, max-age=2592000

/logo-mark.png
  Cache-Control: public, max-age=2592000

/og.png
  Cache-Control: public, max-age=2592000

# The Sveltia CMS editor. Never indexed, on any host.
#
# The header is what a crawler obeys; /admin/index.html carries a robots meta
# tag as well, because the two cost nothing together and the failure mode — the
# editor turning up in a search result for "malaysiavisaguide admin" — is the
# kind you only notice months later.
#
# Both patterns are listed on purpose. A prefix rule matches what is UNDER the
# prefix, and the editor's own URL is the directory itself, so `/admin/*` alone
# would leave the one page that matters uncovered. That trap has already been
# paid for once here with the root brand assets.
/admin/
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

# The CMS bundle is 1.9 MB and its path is stable, so it is not content-hashed
# and cannot be immutable. A week is long enough to matter for a tool opened
# most days, and short enough that an upgrade lands without anyone clearing a
# cache.
/admin/sveltia-cms.js
  Cache-Control: public, max-age=604800
