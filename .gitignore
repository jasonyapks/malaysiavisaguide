# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Never commit — standing rule
private/

# Secrets
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
id_rsa*
.dev.vars

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# wrangler local state — the local D1 SQLite file and dev caches. Machine-local
# scratch, and it holds whatever test rows were last seeded into it.
.wrangler/
**/.wrangler/

# Articles pulled out of D1 for the /humanizer pass. Working copies of live rows,
# and they carry the pasted source text of manually keyed-in stories — publisher
# wording that is model input and belongs nowhere near a repo.
worker/.drafts/

# typescript
*.tsbuildinfo
next-env.d.ts

# OS / editor
*.log
.vscode/
.idea/

# Images pulled out of R2 by scripts/pull-images.mjs, and the registry it writes
# alongside them. Build artifacts: D1's `assets` table and the mvg-assets bucket
# are the source of truth, and a repo that also carried the binaries would have
# two. `prebuild` regenerates both, in CI as well as locally.
/public/images/cms/
/src/lib/data/article-images.json
# The directory scripts/article-image.mjs used to write into, before the images
# moved to R2. Ignored rather than merely deleted so a stale local copy cannot
# creep back into a commit.
/public/images/news/

# The /insights/ dynamic routes, placed by scripts/sync-insight-routes.mjs when
# the CMS has something for them to render and removed when it does not. The
# reviewable source is src/lib/insight-routes/; these are copies of it. Committed
# they would be a second source of truth for whether the routes should exist —
# and `output: "export"` hard-fails a dynamic route with zero paths, so a
# committed copy means a repo that cannot build until an article is published.
/src/app/insights/[category]/

# The figure catalogue the dashboard's picker reads, regenerated from
# programmes.ts on every build by scripts/emit-figures.mjs.
/public/figures.json
